#!/usr/bin/env nextflow

/*
 * ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 * generate_alis Nextflow pipeline
 * Author: Miguel Ramon (miguel.ramon@upf.edu)
 *
 * File: nextflow.config
 * ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 */

params {
    help            = false
    use_singularity = false
    use_apptainer   = false
}

profiles {
    singularity {
        params.use_singularity  = true
        process.container       = "$baseDir/apptainer/generate-alis-latest.img"
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.cacheDir    = ""
        singularity.ociAutoPull = false
    }
    apptainer {
        params.use_apptainer    = true
        process.container       = "$baseDir/apptainer/generate-alis-latest.img"
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = ""
        apptainer.ociAutoPull   = false
    }
    slurm {
        params {
            config_profile_description = 'Marvin Cluster @UPF-CSIC'
            config_profile_contact     = 'miguel.ramon@upf.edu'
            max_memory                 = 256.GB
            max_cpus                   = 128
            max_time                   = 960.h
        }
        process {
            executor = 'slurm'
            queue    = 'haswell'
            beforeScript = """
                export PATH=/usr/local/slurm/bin:\$PATH
                export LD_LIBRARY_PATH=/usr/local/slurm/lib:\$LD_LIBRARY_PATH
            """
        }
    }
    local {
        params {
            config_profile_description = 'Local run'
            config_profile_contact     = 'miguel.ramon@upf.edu'
            max_memory                 = 64.GB
            max_cpus                   = 32
            max_time                   = 5.day
        }
        process {
            executor = 'local'
        }
    }
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'generate-alis'
    author          = 'Miguel Ramon Alonso'
    homePage        = ''
    description     = 'Nextflow pipeline for mammalian CDS alignment generation, variability and positive selection'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=21.04.0'
    version         = '1.0'
}

def parse_slurm_cpu_value(value, int fallback) {
    if (value == null) return fallback
    def text = value.toString().trim()
    if (!text) return fallback
    if (text ==~ /^\d+$/) return text.toInteger()
    def matcher = text =~ /^(\d+)(?:\(x\d+\))?$/
    if (matcher.matches()) return matcher[0][1].toInteger()
    return fallback
}

def get_allocated_cpus(int node_max_cpu) {
    return parse_slurm_cpu_value(
        System.getenv('SLURM_CPUS_PER_TASK') ?: System.getenv('SLURM_JOB_CPUS_PER_NODE'),
        node_max_cpu
    )
}

def get_allocated_mem(int node_max_mem) {
    def memPerCpu   = System.getenv('SLURM_MEM_PER_CPU')
    def cpusPerTask = parse_slurm_cpu_value(
        System.getenv('SLURM_CPUS_PER_TASK') ?: System.getenv('SLURM_JOB_CPUS_PER_NODE'), 0
    )
    if (memPerCpu && cpusPerTask) {
        node_max_mem = memPerCpu.toInteger().intdiv(1000) * cpusPerTask
    }
    return "${node_max_mem}.GB"
}

def check_max(obj, type) {
    try {
        switch (type) {
            case 'memory':
                return (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                       ? params.max_memory as nextflow.util.MemoryUnit : obj
            case 'time':
                return (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                       ? params.max_time as nextflow.util.Duration : obj
            case 'cpus':
                return Math.min(obj, params.max_cpus as int)
            default:
                return obj
        }
    } catch (all) {
        println "### WARNING ### Invalid params.max_${type}='${params["max_${type}"]}' – using default $obj"
        return obj
    }
}

executor {
    $local {
        cpus   = get_allocated_cpus(32)
        memory = get_allocated_mem(64)
    }
    $slurm {
        submitRateLimit = '30/1min'
        queueSize       = 100
        exitReadTimeout = 7.day
    }
}

includeConfig 'conf/common.config'
includeConfig 'conf/resources.config'
includeConfig 'conf/quality.config'
includeConfig 'conf/translation.config'
includeConfig 'conf/phylogeny.config'
includeConfig 'conf/variability.config'
includeConfig 'conf/positive_selection.config'
