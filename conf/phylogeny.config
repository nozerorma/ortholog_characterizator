/*
 * Phylogeny workflow parameters: gene trees and species tree inference.
 */

params {
    // ── Gene trees: IQ-TREE ML on protein alignments ──────────────────────
    iqtree_model          = "MFP"         // ModelFinder Plus: model selection + tree inference in one pass
    iqtree_mset           = "LG"          // restrict model selection to this family (null = all models)
    iqtree_bootstrap      = 1000          // ultrafast bootstrap replicates (UFBoot)

    // ── Species tree method ────────────────────────────────────────────────
    // 'astral'   — de-novo coalescent species tree (ASTRAL-IV)
    // 'backbone' — constrained ASTRAL using a backbone tree (e.g. Zoonomia)
    species_tree_method   = "astral"

    backbone_tree         = null          // path to backbone Newick (backbone mode)
    outgroup_taxa         = null          // comma-sep assembly names for rooting

    // ── Batch sizes ────────────────────────────────────────────────────────
    genetree_batch_size    = 50           // genes per Nextflow gene-tree job
    genetree_batch_workers = 4            // concurrent genes within one job
}
