/*
 * Process resources.
 *
 * Label blocks set category-wide defaults; withName blocks give per-process
 * overrides so resources can be tuned without changing process source files.
 *
 * Labels:
 *   process_light        — single-CPU bookkeeping tasks
 *   process_medium       — moderate compute, scales on retry
 *   process_single       — single-CPU aggregation / report steps
 *   process_batch_light  — batched per-gene jobs: light tools (dedup, filter, translate)
 *   process_batch_heavy  — batched per-gene jobs: heavy tools (BMGE, IQ-TREE, HyPhy)
 *   process_long         — long-running sequential jobs (ASTRAL)
 *   process_hmmscan      — chunked hmmscan jobs
 */

params {
    max_memory = 64.GB
    max_cpus   = 32
    max_time   = 5.day
}

process {

    // ── Label defaults ────────────────────────────────────────────────────────

    withLabel:process_light {
        cpus   = { 1 }
        memory = { 500.MB }
        time   = { 30.m }
    }
    withLabel:process_medium {
        cpus   = { 4 }
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_single {
        cpus   = { 1 }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_batch_light {
        cpus          = { 8 }
        memory        = { 4.GB  * task.attempt }
        time          = { 6.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withLabel:process_batch_heavy {
        cpus          = { 16 }
        memory        = { 16.GB * task.attempt }
        time          = { 24.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withLabel:process_long {
        cpus          = { 8 }
        memory        = { 16.GB * task.attempt }
        time          = { 48.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }
    withLabel:process_hmmscan {
        cpus          = { 16 }
        memory        = { 16.GB * task.attempt }
        time          = { 24.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // ── Per-process overrides ─────────────────────────────────────────────────
    // These take precedence over label defaults.

    // Quality
    withName:COUNT_ASSEMBLY_GENES {
        cpus   = { 1 }
        memory = { 4.GB }
        time   = { 1.h  }
    }
    withName:DEDUP_BATCH {
        cpus          = { 8 }
        memory        = { 8.GB  * task.attempt }
        time          = { 6.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:CHI2_FILTER_BATCH {
        cpus          = { 8 }
        memory        = { 4.GB  * task.attempt }
        time          = { 4.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:THRESHOLD_FILTER_BATCH {
        cpus          = { 8 }
        memory        = { 4.GB  * task.attempt }
        time          = { 2.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }

    // Translation
    withName:BMGE_BATCH {
        cpus          = { 8 }
        memory        = { 8.GB  * task.attempt }  // Java heap per worker
        time          = { 6.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:BMGE_MAP_BATCH {
        cpus          = { 8 }
        memory        = { 4.GB  * task.attempt }
        time          = { 4.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:GENERATE_METADATA {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withName:QUALITY_REPORT_DATA {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withName:RENDER_TRANSLATION_REPORT {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // Variability
    withName:VARIABILITY_BATCH {
        cpus          = { 8 }
        memory        = { 8.GB  * task.attempt }
        time          = { 6.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:AGGREGATE_VARIABILITY {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName:HMMSCAN_BATCH {
        cpus          = { 16 }
        memory        = { 16.GB * task.attempt }
        time          = { 24.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }
    withName:MERGE_DOMTBLOUT {
        cpus   = { 1 }
        memory = { 2.GB }
        time   = { 30.m }
    }
    withName:MAP_DOMAIN_VARIABILITY {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName:RENDER_VARIABILITY_REPORT {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // Phylogeny
    withName:PRUNE_BACKBONE {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withName:ASTRAL_DENOVO {
        cpus          = { 8 }
        memory        = { 32.GB * task.attempt }
        time          = { 48.h  * task.attempt }
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'finish' }
        maxRetries    = 1
    }
    withName:ASTRAL_BACKBONE {
        cpus          = { 8 }
        memory        = { 32.GB * task.attempt }
        time          = { 48.h  * task.attempt }
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'finish' }
        maxRetries    = 1
    }
    withName:IQTREE_BATCH {
        cpus          = { 16 }
        memory        = { 32.GB * task.attempt }
        time          = { 24.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    // Positive selection
    withName:PRUNE_TREE_BATCH {
        cpus          = { 8 }
        memory        = { 4.GB  * task.attempt }
        time          = { 4.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:HYPHY_BATCH {
        cpus          = { 16 }
        memory        = { 32.GB * task.attempt }
        time          = { 24.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:AGGREGATE_FIRST_PASS {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName:HYPHY_MEME_BATCH {
        cpus          = { 16 }
        memory        = { 32.GB * task.attempt }
        time          = { 48.h  * task.attempt }  // MEME is much slower than FEL/FUBAR
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:AGGREGATE_FINAL {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName:RENDER_PSEL_REPORT {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
}
