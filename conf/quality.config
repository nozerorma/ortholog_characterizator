/*
 * Quality workflow parameters: deduplication and pre-alignment filtering.
 */

params {
    // ── Deduplication ──────────────────────────────────────────────────────
    run_dedup             = true   // set false to skip dedup and pass raw CDS forward

    // ── Quality filter mode ────────────────────────────────────────────────
    // 'chi2'      — iterative chi-square outlier removal (chisq-test.py)
    // 'threshold' — remove sequences below min_seq_frac coverage (no chi2 test)
    // 'none'      — pass deduplicated alignments directly to translation
    filter_mode           = "chi2"

    // ── Chi2 filter params ─────────────────────────────────────────────────
    chi2_max_iter         = 3     // max removal iterations
    chi2_ambiguity_thresh = 0.8   // max ambiguous-codon fraction across whole alignment  (default: 0.8)
    chi2_min_seq_frac     = 0.1   // min fraction of sequences that must survive filtering (default: 0.1)

    // ── Threshold filter params (filter_mode = 'threshold') ────────────────
    // Minimum non-gap, non-N fraction of the alignment length a sequence must
    // have to be kept.  Equivalently: drop if ambiguity > (1 - threshold).
    //   0.2 → drop sequences with >80% gaps/N  (recommended)
    //   0.1 → drop sequences with >90% gaps/N  (very permissive)
    //   0.5 → drop sequences with >50% gaps/N  (strict)
    threshold_min_seq_frac = 0.2

    // ── Minimum sequences ──────────────────────────────────────────────────
    // Alignments with fewer sequences after filtering are dropped downstream
    min_seqs              = 4

    // ── Batch sizes ────────────────────────────────────────────────────────
    dedup_batch_size      = 500   // genes per Nextflow DEDUP job
    dedup_batch_workers   = 8     // concurrent genes within one DEDUP job
    filter_batch_size     = 500   // genes per Nextflow FILTER job
    filter_batch_workers  = 8     // concurrent genes within one FILTER job
}
