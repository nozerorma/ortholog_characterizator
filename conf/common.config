/*
 * Common parameters shared across all workflows.
 */

params {
    // ── Input ──────────────────────────────────────────────────────────────
    cds_dir               = null   // directory of input codon CDS alignments (.fa)
    out_dir               = "results"
    gene_list             = null   // optional: plain-text file, one gene name per line

    // ── Taxonomy / reference files ─────────────────────────────────────────
    assemblies_tsv        = null   // assemblies_and_species_mammals.tsv
    taxid_tsv             = null   // taxid_species_family_mammals.tsv
    species_dedup_map     = null   // species_dedup_map.tsv
    family_order_tsv      = null   // family_to_order.tsv

    // ── Test mode ──────────────────────────────────────────────────────────
    // When true, randomly samples test_n_genes alignments from cds_dir before
    // running any workflow stage.  Use to quickly validate the pipeline on a
    // small subset without changing any other parameters.
    test_mode    = false
    test_n_genes = 100
    test_seed    = 42    // fixed seed for reproducibility; set null for random

    // ── Workflow toggles ───────────────────────────────────────────────────
    run_quality            = true
    run_translation        = true
    run_phylogeny          = false
    run_variability        = false
    run_positive_selection = false
    run_ucr                = false   // UCR analysis (requires run_variability = true)

    // ── Fallback input dirs (used when upstream workflow is skipped) ────────
    dedup_dir             = null   // pre-existing DEDUP output dir
    prot_dir              = null   // pre-existing PROT/bmge output dir (protein alignments)
    trim_dir              = null   // pre-existing TRIM/bmge output dir (BMGE-trimmed CDS)
    map_dir               = null   // pre-existing MAP output dir (*.map.tsv position maps)
    entropy_dir           = null   // PFAM_ONLY: directory of existing <gene>.entropy.tsv tables
    sel_variability_tsv   = null   // sel_variability.tsv from a prior positive-selection run
    variability_tsv       = null   // gene_variability.tsv from a prior variability run (psel report fallback)

    // ── Global resource caps (overridden by profiles) ──────────────────────
    max_memory            = 64.GB
    max_cpus              = 32
    max_time              = 5.day
}

// Capture exit codes from upstream processes when piping
// Different reports and logs to capture execution details.
timeline {
    enabled = true
    file    = "${params.out_dir}/pipeline_info/execution_timeline_.html"
}
report {
    enabled = true
    file    = "${params.out_dir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    trace.overwrite = true
    file    = "${params.out_dir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.out_dir}/pipeline_info/pipeline_dag.html"
}
tower {
    accessToken = "eyJ0aWQiOiAxMTg2MX0uYmFkMTY1ZDk0MGQxZmU0MTRjOWIyYTdmOThkMjdmZDU0OTQ1OTAzZA==" // Replace with your actual Tower access token if you want to use Nextflow Tower for monitoring
    enabled = false // Set to true to enable Nextflow Tower monitoring
}
