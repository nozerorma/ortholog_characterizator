/*
 * Translation workflow parameters: alignment trimming and protein projection.
 *
 * BMGE is the only translation mode. It handles codon-aware trimming and
 * projects the kept codons to amino acids (-oaaf). Trimming aggressiveness
 * is controlled by two thresholds:
 *
 *   bmge_gap_threshold   (-g): maximum gap rate allowed per column (0–1).
 *                              1.0 = keep all columns regardless of gaps (no trimming).
 *                              0.0 = remove any column with even one gap (maximum trimming).
 *                              0.2 = BMGE default, removes columns with >20% gaps.
 *
 *   bmge_entropy_threshold (-h): max per-column entropy score (0–1).
 *                              1.0 = keep everything regardless of variability
 *                                    → use this for positive selection (HyPhy)
 *                                      and CAAS, where variable sites are the signal.
 *                              0.5 = BMGE default, removes high-entropy columns
 *                                    → suitable for species/gene tree production only.
 */

params {
    // ── BMGE parameters ────────────────────────────────────────────────────
    bmge_gap_threshold        = 1.0       // -g: 1.0 = no gap trimming (keep all columns)
    bmge_entropy_threshold    = 1.0       // -h: 1.0 = no entropy trimming; use 0.5 for tree-only runs
    bmge_matrix               = "BLOSUM62"

    // ── Position mapping (optional) ───────────────────────────────────────
    gff_file                  = null      // hg38 GFF3 for genomic coordinate mapping
    gene_equiv_tsv            = null      // gene→protein_id equivalence TSV

    // ── Batch sizes ────────────────────────────────────────────────────────
    translation_batch_size    = 200       // genes per Nextflow translation job
    translation_batch_workers = 6         // concurrent genes within one job
}
