/*
 * Variability workflow parameters: Valdar entropy and Pfam domain mapping.
 */

params {
    // ── Valdar C_trident weights ───────────────────────────────────────────
    valdar_alpha          = 1.0   // symbol-diversity weight
    valdar_beta           = 1.0   // stereochemical-diversity weight
    valdar_gamma          = 1.0   // gap-penalty weight
    zscore_threshold      = 1.5   // z-score threshold for clade outlier detection

    // ── Pfam / HMMer ──────────────────────────────────────────────────────
    run_hmmscan           = true  // set true to run hmmscan against Pfam
    pfam_hmm              = "/data/samanthafs/scratch/lab_anavarro/mramon/4.Generate_alignments_from_codons/pfam/Pfam-A.hmm"   // path to Pfam-A.hmm
    hmmscan_domtblout     = null   // pre-computed domtblout (skip hmmscan if set)
    hmmscan_cpus          = 16     // CPU threads for hmmscan
    pfam_descriptions_tsv = "/data/samanthafs/scratch/lab_anavarro/mramon/4.Generate_alignments_from_codons/taxa_info/pfam_descriptions.tsv"   // pfam_descriptions.tsv for domain annotation
    pfam_clans_tsv        = "/data/samanthafs/scratch/lab_anavarro/mramon/4.Generate_alignments_from_codons/pfam/Pfam-A.clans.tsv"             // Pfam-A.clans.tsv for clan-level grouping

    // ── Batch sizes ────────────────────────────────────────────────────────
    variability_batch_size    = 24
    variability_batch_workers = 8

    // ── UCR detection (used when run_ucr = true) ───────────────────────────
    // Method 1 — absolute: consecutive positions with C_trident >= threshold
    ucr_abs_threshold     = 0.9    // C_trident floor
    ucr_abs_min_len       = 5      // minimum consecutive positions
    ucr_abs_max_gap       = 0.3    // max mean gap fraction

    // Method 2 — relative: positions with within-gene C_trident z-score >= threshold
    ucr_rel_zscore        = 1.5    // z-score cutoff
    ucr_rel_min_len       = 5      // minimum consecutive positions

    // Method 3 — sliding window: mean C_trident over k aa >= threshold
    ucr_window_size       = 10     // window size in aa
    ucr_window_threshold  = 0.85   // mean C_trident floor
    ucr_window_max_pos_gap = 0.3   // max gap fraction for any single position in window

    // Shared
    ucr_flank_size        = 5      // flanking aa added on each side of every detected window

    // Optional site-level cross-references (used by AGGREGATE_UCR)
    // Set these when running UCR without a concurrent positive-selection run
    fubar_sites_tsv       = null   // fubar_sites.tsv from a prior positive-selection run
}
