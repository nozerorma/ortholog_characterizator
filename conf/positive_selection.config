/*
 * Positive selection workflow parameters: HyPhy analyses.
 */

params {
    // ── HyPhy methods ─────────────────────────────────────────────────────
    // Comma-separated list: FUBAR, FEL
    // MEME is added automatically as a second pass for genes with >= meme_min_sites FUBAR hits
    hyphy_methods         = "FUBAR"

    // ── Thresholds ────────────────────────────────────────────────────────
    fubar_threshold       = 0.9   // posterior probability threshold for FUBAR positive site
    meme_min_sites        = 1     // min FUBAR-positive sites to trigger MEME

    // ── Required inputs ───────────────────────────────────────────────────
    // Pruned species tree (Newick). Required; pipeline asserts this is set.
    psel_species_tree     = null

    // ── Optional join ─────────────────────────────────────────────────────
    variability_tsv       = null  // gene_variability.tsv from variability workflow

    // ── Batch sizes ────────────────────────────────────────────────────────
    psel_batch_size       = 100
    psel_batch_workers    = 4
}
