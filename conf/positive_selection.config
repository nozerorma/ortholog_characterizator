/*
 * Positive selection workflow parameters: HyPhy analyses.
 */

params {
    // ── HyPhy methods ─────────────────────────────────────────────────────
    // Comma-separated first-pass list: FUBAR, FEL, BUSTED.
    // BUSTED is the gene-level gate: MEME runs as a second pass only on genes
    // significant at BUSTED BH-FDR <= busted_fdr. If BUSTED is omitted, the gate
    // falls back to FUBAR FDR sites (>= meme_min_sites per gene).
    hyphy_methods         = "FUBAR,BUSTED"

    // ── Thresholds ────────────────────────────────────────────────────────
    fubar_threshold       = 0.9   // posterior floor before Bayesian FDR is applied
    fubar_fdr             = 0.05  // target empirical Bayesian FDR for FUBAR site calls
    busted_fdr            = 0.05  // target BH-FDR for the gene-level BUSTED gate
    meme_fdr              = 0.05  // target BH-FDR for MEME site calls (after dS>0 / boundary guards)
    meme_min_sites        = 1     // fallback gate (FUBAR-FDR sites) when BUSTED is not run

    // ── Required inputs ───────────────────────────────────────────────────
    // Pruned species tree (Newick). Required; pipeline asserts this is set.
    psel_species_tree     = null

    // ── Optional join ─────────────────────────────────────────────────────
    variability_tsv       = null  // gene_variability.tsv from variability workflow

    // ── Batch sizes ────────────────────────────────────────────────────────
    psel_batch_size       = 100
    psel_batch_workers    = 4
}
